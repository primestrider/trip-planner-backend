generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  password String
  name     String?

  role     UserRole @default(USER)
  isActive Boolean  @default(true)

  passwordChangedAt   DateTime? @db.Timestamp(0)
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime? @db.Timestamp(0)
  lastLoginAt         DateTime? @db.Timestamp(0)

  // 🔽 AVATAR RELATION
  avatarId Int?
  avatar   Avatar? @relation(fields: [avatarId], references: [id])

  accessTokens    UserAccessToken[]
  trips           Trip[]
  tripMemberships TripMember[]

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0)

  @@index([avatarId])
  @@map("users")
}

model UserAccessToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String

  tokenHash String
  expiresAt DateTime  @db.Timestamp(0)
  revokedAt DateTime? @db.Timestamp(0)

  createdAt DateTime @default(now()) @db.Timestamp(0)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt, expiresAt])
  @@map("user_access_tokens")
}

model Avatar {
  id       Int     @id @default(autoincrement())
  url      String  @unique @db.VarChar(255)
  isActive Boolean @default(true)
  order    Int     @default(0)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trip {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String  @db.VarChar(150)
  destination String  @db.VarChar(150)
  description String? @db.Text

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  itineraryItems ItineraryItem[]
  members        TripMember[]

  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)

  @@index([userId, startDate])
  @@map("trips")
}

// Role of a collaborator; the trip owner is Trip.userId
enum TripMemberRole {
  EDITOR
  VIEWER
}

model TripMember {
  id String @id @default(uuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TripMemberRole

  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

model ItineraryItem {
  id String @id @default(uuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // 1-based day of the trip (Day 1 = trip startDate)
  dayNumber Int

  title       String  @db.VarChar(150)
  description String? @db.Text

  // place, typically picked from Google Maps
  locationName      String?  @db.VarChar(255)
  locationAddress   String?  @db.VarChar(500)
  locationLatitude  Decimal? @db.Decimal(9, 6)
  locationLongitude Decimal? @db.Decimal(9, 6)
  locationPlaceId   String?  @db.VarChar(255)
  locationUrl       String?  @db.VarChar(2048)

  // HH:mm (24h)
  startTime String? @db.VarChar(5)
  endTime   String? @db.VarChar(5)

  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)

  @@index([tripId, dayNumber])
  @@map("itinerary_items")
}
